{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizbattle.local/schemas/question-bank-v1.json",
  "title": "QuizBattle Arabic Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "difficulty",
    "prompt",
    "options",
    "correctOptionIndex",
    "explanation",
    "source",
    "verifiedAt",
    "language",
    "status",
    "contentHash"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^qb-[a-z0-9-]+-[0-9]{4}$"},
    "category": {
      "type": "string",
      "enum": [
        "mathematics",
        "science",
        "geography",
        "cities",
        "history",
        "civics",
        "religion",
        "technology",
        "general-knowledge"
      ]
    },
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "prompt": {"type": "string", "minLength": 10, "maxLength": 220},
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "correctOptionIndex": {"type": "integer", "minimum": 0, "maximum": 3},
    "explanation": {"type": "string", "minLength": 10, "maxLength": 500},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "url", "license"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "verifiedAt": {"type": "string", "format": "date-time"},
    "language": {"const": "ar"},
    "status": {"const": "active"},
    "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
