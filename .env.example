# Local development only. Replace JWT_SECRET before starting the application.
APP_ENV=development
PORT=8080
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DATABASE=quizbattle
JWT_SECRET=
SESSION_TTL=1h
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXY_CIDRS=
SEED_DATABASE=true
QUESTION_BANK_PATH=../data/question-bank/questions.ar.jsonl

# Redis is optional until distributed game events are implemented.
REDIS_ADDRESS=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
