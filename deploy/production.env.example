# Template only. Do not copy placeholder secrets into production.
# Preferred first-release setup after installing deploy/* in /home/Qubefyn/QuizBattle:
#   sudo ./bootstrap-secrets.sh --bootstrap --origin https://quizbattle.qubefyn.com
# The workflow atomically replaces the bootstrap image/release sentinel during the
# first deployment.
# The bootstrap writes /home/Qubefyn/QuizBattle/.env as root:root mode 0600.

COMPOSE_PROJECT_NAME=quizbattle
QUIZBATTLE_IMAGE=REPLACE_WITH_EXACT_IMAGE_AT_SHA256_DIGEST
RELEASE_SHA=REPLACE_WITH_FULL_GIT_SHA
APP_PORT=3200
APP_ENV=production

MONGO_REPLICA_SET=rs0
MONGO_ROOT_USERNAME=quizbattle_root
MONGO_APP_USERNAME=quizbattle_app
MONGO_DATABASE=quizbattle
MONGO_URI=mongodb://quizbattle_app:REPLACE_WITH_GENERATED_PASSWORD@mongo:27017/quizbattle?authSource=quizbattle&authMechanism=SCRAM-SHA-256&replicaSet=rs0&tls=true&tlsCAFile=/run/quizbattle/tls/mongo-ca.crt

JWT_SECRET=REPLACE_WITH_GENERATED_RANDOM_SECRET
SESSION_TTL=1h
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://quiz.example.com
TRUSTED_PROXY_CIDRS=172.30.8.1/32
SEED_DATABASE=true

# Required root-owned files are generated under ./secrets. Never commit them:
# mongo-root-password, mongo-app-password, jwt-secret, mongo-keyfile,
# mongo-ca.key/crt, mongo-server.key/crt/pem, and backup keys/certificate.
# Start with plain `docker compose up -d`; do not scale app beyond one instance.
